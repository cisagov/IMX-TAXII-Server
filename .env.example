# Server serial number
# Set this to a random UUID
# Indices will be localized with this...

TAXII_XUUID=

# ---------------------------------------------------------------------

# Server core configuration

# internal port (for Docker network reference)
#TAXII_PORT=443
TAXII_PORT=80

# URL (primarily used for protocol / port - see README.md)
#TAXII_URL=https://taxii4j2:${TAXII_PORT}/
TAXII_URL=http://taxii4j2:${TAXII_PORT}/

# port on Docker host
#TAXII_EXPOSED_PORT=9443
TAXII_EXPOSED_PORT=8080

# password for user 'imx-admin' bootstrap administrator
# Set this to a secure password
TAXII_PASSWORD='taxii-pass'

TAXII_IO=./io
TAXII_BOOTSTRAP=./bootstrap

# ---------------------------------------------------------------------

# OpenSearch configuration

# URL for REST API
OPENSEARCH_URL=http://opensearch:9200/

# password for user 'admin'
OPENSEARCH_PASSWORD=''

# host bind path for snapshot storage
# (container path hard wired as /opt/snapshots)
OPENSEARCH_SNAPSHOTS=./snapshots

# ---------------------------------------------------------------------

# support URLs

VALIDATOR_URL=http://stix2-validator:5000/
SCHEMA_DIR=/opt/schema

# ---------------------------------------------------------------------

# Github configuration
# TAXII server will download schemas from the oasis-open/cti-stix-common-objects Github repository.
# For non-rate-limited access to Github, add an API token here.

#GITHUB_TOKEN=
GIT_REPOS=./repos

# ---------------------------------------------------------------------

# A1 configuration
# For connectivity to an Analyst1 instance, set URL and credentials here.

#A1_HOST=
#A1_USER=
#A1_PASS=

# ---------------------------------------------------------------------

# MISP configuration
# For connectivity to a MISP server, set the URL and API token here.

#MISP_TOKEN=
#MISP_URL=
# ---------------------------------------------------------------------

# External keystore configuration
# To run the TAXII server over HTTPS, set these appropriately.

TAXII_KEYSTORE_DIR=./keystore
#TAXII_KEYSTORE=/opt/keystore/keystore.p12
#TAXII_KEYSTORE_PASSWORD=password
#TAXII_KEYSTORE_ALIAS=my-alias

# ---------------------------------------------------------------------

# OIDC configuration
# To use an OIDC provider for user authentication, set this to the OIDC provider endpoint.

#VALID_ISSUERS='[ { "iss": "http://host.docker.internal:8080/realms/test" } ]'

