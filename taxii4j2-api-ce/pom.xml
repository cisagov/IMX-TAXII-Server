			<url>
				${env.MAVEN_REPOSITORY_URL}</url>
		</repository>
		<snapshotRepository>
			<id>ties-gitlab</id>
			<url>
				${env.MAVEN_REPOSITORY_URL}</url>
		</snapshotRepository>
	</distributionManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>2.8.2</version>
			</plugin>
		</plugins>
	</build>

</project>
